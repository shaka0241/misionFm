---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Misión 94.3 FM — Inicio">
  <!-- ══ HERO ══ -->
  <section
    class="relative min-h-screen flex flex-col items-center justify-center text-center overflow-hidden"
    style="background: linear-gradient(135deg, #0a0e52 0%, #1a237e 50%, #0d0d0d 100%);"
  >
    <!-- Background decorative circles -->
    <div
      class="absolute top-10 left-10 w-64 h-64 rounded-full opacity-10"
      style="background: radial-gradient(circle, #d32f2f, transparent);"
    >
    </div>
    <div
      class="absolute bottom-20 right-10 w-96 h-96 rounded-full opacity-10"
      style="background: radial-gradient(circle, #d32f2f, transparent);"
    >
    </div>

    <!-- Signal rings -->
    <div
      class="absolute inset-0 flex items-center justify-center pointer-events-none"
    >
      <div
        class="w-64 h-64 rounded-full border border-blue-500/10 animate-ping animation-duration-[3s]"
      >
      </div>
    </div>

    <div class="relative z-10 px-4 max-w-4xl mx-auto">
      <!-- Logo icon -->
      <div
        class="mx-auto mb-6 w-24 h-24 rounded-full bg-brand-primary flex items-center justify-center pulse-glow fade-in-up"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-14 h-14 text-white"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14v-4H9l3-6 3 6h-2v4h-2z"
          ></path>
        </svg>
      </div>

      <!-- Title -->
      <h1
        class="text-6xl sm:text-7xl md:text-8xl font-black tracking-tight mb-2 fade-in-up fade-in-up-2"
      >
        <span class="gradient-text">MISIÓN</span>
      </h1>
      <p
        class="text-4xl sm:text-5xl font-black text-brand-primary mb-3 fade-in-up fade-in-up-2"
      >
        94.3 FM
      </p>
      <p
        class="text-blue-200 text-lg sm:text-xl font-light tracking-widest uppercase mb-10 fade-in-up fade-in-up-3"
      >
        Radio de Cabimas, Zulia
      </p>

      <!-- Wave animation -->
      <div
        class="flex items-end justify-center gap-2 mb-10 fade-in-up fade-in-up-3"
        style="height:48px;"
      >
        <span class="wave-bar" style="height:18px;"></span>
        <span class="wave-bar" style="height:32px;"></span>
        <span class="wave-bar" style="height:48px;"></span>
        <span class="wave-bar" style="height:28px;"></span>
        <span class="wave-bar" style="height:40px;"></span>
        <span class="wave-bar" style="height:22px;"></span>
        <span class="wave-bar" style="height:36px;"></span>
      </div>

      <!-- CTA buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center fade-in-up fade-in-up-4"
      >
        <button
          id="hero-play-btn"
          class="group flex items-center gap-3 bg-brand-primary hover:bg-blue-700 text-white font-bold text-lg px-8 py-4 rounded-full pulse-glow transition-all hover:scale-105"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
            ><path d="M8 5v14l11-7z"></path></svg
          >
          ¡ESCÚCHALA!
        </button>
        <a
          href="https://zeno.fm/player/unsxrfcdn5jtv"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 border-2 border-blue-300 hover:border-white text-blue-200 hover:text-white font-semibold px-7 py-4 rounded-full transition-all hover:scale-105"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M11 17H7a5 5 0 0 1 0-10h4v2H7a3 3 0 0 0 0 6h4v2zm-3-4v-2h8v2H8zm5 4v-2h4a3 3 0 0 0 0-6h-4V7h4a5 5 0 0 1 0 10h-4z"
            ></path>
          </svg>
          Reproductor alternativo
        </a>
      </div>

      <!-- Zeno.fm embedded player -->
      <!-- <div class="mt-8 fade-in-up fade-in-up-4 w-full max-w-sm mx-auto">
        <iframe
          src="https://zeno.fm/player/unsxrfcdn5jtv"
          width="100%"
          height="180"
          frameborder="0"
          scrolling="no"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          title="Reproductor Misión 94.3 FM"
          class="rounded-2xl shadow-2xl"></iframe>
      </div> -->
    </div>

    <!-- Scroll hint -->
    <div
      class="absolute bottom-8 left-1/2 -translate-x-1/2 text-blue-300 animate-bounce"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>
  </section>

  <!-- ══ SÍGUENOS ══ -->
  <section class="py-20 bg-neutral-light">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mb-3">
        ¡SÍGUENOS!
      </h2>
      <p class="text-gray-500 mb-10">
        Conéctate con nosotros en redes sociales
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <!-- Facebook -->
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover flex items-center gap-4 bg-white rounded-2xl px-8 py-5 shadow-md border border-gray-100 hover:border-[#3b5998]"
        >
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center bg-[#3b5998]"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-bold text-neutral-dark">Facebook</p>
            <p class="text-sm text-gray-500">Misión 94.3 FM</p>
          </div>
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover flex items-center gap-4 bg-white rounded-2xl px-8 py-5 shadow-md border border-gray-100"
        >
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center"
            style="background: linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="white" stroke="none"
              ></circle>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-bold text-neutral-dark">Instagram</p>
            <p class="text-sm text-gray-500">@mision943fm</p>
          </div>
        </a>

        <!-- Twitter/X -->
        <a
          href="https://twitter.com"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover flex items-center gap-4 bg-white rounded-2xl px-8 py-5 shadow-md border border-gray-100 hover:border-[#1da1f2]"
        >
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center bg-[#1da1f2]"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"
              ></path>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-bold text-neutral-dark">Twitter / X</p>
            <p class="text-sm text-gray-500">@mision943fm</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ ACERCA DE — mini ══ -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span
          class="text-brand-primary font-bold uppercase text-sm tracking-widest"
          >Radio de Cabimas</span
        >
        <h2
          class="text-3xl sm:text-4xl font-black text-brand-dark mt-2 mb-4 leading-tight"
        >
          La voz de nuestra gente
        </h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          Misión 94.3 FM es un proyecto comunicacional identificado con el
          proceso de formación, comunicación y asistencia técnica interactiva.
        </p>
        <a
          href="/quienes-somos"
          class="inline-flex items-center gap-2 bg-brand-dark text-white font-semibold px-6 py-3 rounded-full hover:bg-blue-900 transition-colors"
        >
          Conoce más
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {
          [
            { icon: "📡", label: "Frecuencia", value: "94.3 FM" },
            { icon: "🇻🇪", label: "Ubicación", value: "Cabimas, Zulia" },
            { icon: "🏘️", label: "Enfoque", value: "Local" },
            { icon: "📻", label: "Tipo", value: "Popular Alternativo" },
          ].map((item) => (
            <div class="card-hover bg-neutral-light rounded-2xl p-5 text-center">
              <span class="text-3xl block mb-2">{item.icon}</span>
              <p class="text-xs text-gray-400 font-semibold uppercase tracking-wide">
                {item.label}
              </p>
              <p class="font-bold text-neutral-dark text-sm mt-1">
                {item.value}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ PATROCINANTES / PUBLICIDAD ══ -->
  <section class="py-20 bg-neutral-light border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <span
        class="text-brand-primary font-bold uppercase text-sm tracking-widest"
        >Apoya lo nuestro</span
      >
      <h2 class="text-3xl sm:text-4xl font-black text-brand-dark mt-2 mb-4">
        Nuestros Anunciantes
      </h2>
      <p class="text-gray-500 mb-12 max-w-2xl mx-auto font-medium">
        Gracias a nuestros aliados comerciales podemos seguir al aire. ¿Quieres
        que tu marca se escuche en toda Cabimas? <a
          href="/contacto"
          class="text-brand-primary font-bold hover:underline">Anúnciate aquí</a
        >.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Ad Card 1 (Premium) -->
        <a
          href="#"
          class="group relative bg-white rounded-3xl p-8 border-2 border-transparent hover:border-brand-primary transition-all duration-300 hover:shadow-xl flex flex-col items-center justify-center min-h-[250px] overflow-hidden"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-blue-50 to-indigo-50 opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
          <div class="relative z-10 flex flex-col items-center">
            <div
              class="w-24 h-24 bg-gray-100 rounded-full mb-4 flex items-center justify-center text-gray-400 group-hover:scale-110 group-hover:bg-white group-hover:text-brand-primary transition-all shadow-sm"
            >
              <svg
                class="w-10 h-10"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path></svg
              >
            </div>
            <h3 class="text-xl font-bold text-neutral-dark mb-1">
              Tu Empresa Aquí
            </h3>
            <p class="text-sm text-gray-500 font-medium">Plan Premium</p>
            <span
              class="inline-block mt-5 text-xs font-bold text-white bg-brand-primary px-4 py-1.5 rounded-full uppercase tracking-wide opacity-0 group-hover:opacity-100 transition-all translate-y-2 group-hover:translate-y-0"
              >Saber más</span
            >
          </div>
        </a>

        <!-- Ad Card 2 (Standard) -->
        <a
          href="#"
          class="group relative bg-white rounded-3xl p-8 border border-gray-100 hover:border-blue-300 transition-all duration-300 hover:shadow-lg flex flex-col items-center justify-center min-h-[250px] overflow-hidden"
        >
          <div class="relative z-10 flex flex-col items-center">
            <div
              class="w-20 h-20 bg-gray-50 rounded-2xl mb-4 flex items-center justify-center text-gray-400 group-hover:scale-105 group-hover:text-blue-500 transition-all"
            >
              <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
                ></path></svg
              >
            </div>
            <h3 class="text-lg font-bold text-neutral-dark mb-1">Tu Negocio</h3>
            <p class="text-sm text-gray-400">Plan Básico</p>
          </div>
        </a>

        <!-- Ad Card 3 (Standard) -->
        <a
          href="#"
          class="group relative bg-white rounded-3xl p-8 border border-gray-100 hover:border-blue-300 transition-all duration-300 hover:shadow-lg flex flex-col items-center justify-center min-h-[250px] overflow-hidden"
        >
          <div class="relative z-10 flex flex-col items-center">
            <div
              class="w-20 h-20 bg-gray-50 rounded-2xl mb-4 flex items-center justify-center text-gray-400 group-hover:scale-105 group-hover:text-blue-500 transition-all"
            >
              <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <h3 class="text-lg font-bold text-neutral-dark mb-1">
              Tu Servicio
            </h3>
            <p class="text-sm text-gray-400">Plan Básico</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Hook "hero play" button to the sticky player
  const heroPlayBtn = document.getElementById("hero-play-btn");
  heroPlayBtn?.addEventListener("click", () => {
    document.getElementById("play-btn")?.click();
    document
      .getElementById("audio-player-bar")
      ?.scrollIntoView({ behavior: "smooth" });
  });
</script>

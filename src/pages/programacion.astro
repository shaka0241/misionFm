---
import Layout from '../layouts/Layout.astro';

const dias = [
  {
    dia: 'Lunes',
    color: '#1a237e',
    programas: [
      { hora: '06:00 – 09:00', nombre: 'Buenos Días Cabimas', tipo: 'Matutino' },
      { hora: '10:00 – 12:00', nombre: 'Voces de la Comunidad', tipo: 'Informativo' },
      { hora: '14:00 – 16:00', nombre: 'Cultura Zuliana', tipo: 'Cultural' },
      { hora: '18:00 – 20:00', nombre: 'La Tarde en Misión', tipo: 'Entretenimiento' },
    ],
  },
  {
    dia: 'Martes',
    color: '#d32f2f',
    programas: [
      { hora: '06:00 – 09:00', nombre: 'Buenos Días Cabimas', tipo: 'Matutino' },
      { hora: '10:00 – 12:00', nombre: 'Salud Comunitaria', tipo: 'Informativo' },
      { hora: '14:00 – 16:00', nombre: 'Música Venezolana', tipo: 'Musical' },
      { hora: '18:00 – 20:00', nombre: 'La Tarde en Misión', tipo: 'Entretenimiento' },
    ],
  },
  {
    dia: 'Miércoles',
    color: '#1a237e',
    programas: [
      { hora: '06:00 – 09:00', nombre: 'Buenos Días Cabimas', tipo: 'Matutino' },
      { hora: '10:00 – 12:00', nombre: 'Educación para Todos', tipo: 'Educativo' },
      { hora: '14:00 – 16:00', nombre: 'Emprendimiento Local', tipo: 'Económico' },
      { hora: '18:00 – 20:00', nombre: 'La Tarde en Misión', tipo: 'Entretenimiento' },
    ],
  },
  {
    dia: 'Jueves',
    color: '#d32f2f',
    programas: [
      { hora: '06:00 – 09:00', nombre: 'Buenos Días Cabimas', tipo: 'Matutino' },
      { hora: '10:00 – 12:00', nombre: 'Historias de Mi Barrio', tipo: 'Comunitario' },
      { hora: '14:00 – 16:00', nombre: 'Deporte y Pasión', tipo: 'Deportivo' },
      { hora: '18:00 – 20:00', nombre: 'La Tarde en Misión', tipo: 'Entretenimiento' },
    ],
  },
  {
    dia: 'Viernes',
    color: '#1a237e',
    programas: [
      { hora: '06:00 – 09:00', nombre: 'Buenos Días Cabimas', tipo: 'Matutino' },
      { hora: '10:00 – 12:00', nombre: 'Agenda Cultural', tipo: 'Cultural' },
      { hora: '14:00 – 16:00', nombre: 'Música Popular', tipo: 'Musical' },
      { hora: '18:00 – 22:00', nombre: 'Noche de Viernes', tipo: 'Especial' },
    ],
  },
  {
    dia: 'Sábado',
    color: '#d32f2f',
    programas: [
      { hora: '08:00 – 11:00', nombre: 'Mañana Sabatina', tipo: 'Matutino' },
      { hora: '11:00 – 14:00', nombre: 'Ritmos Latinoamericanos', tipo: 'Musical' },
      { hora: '16:00 – 19:00', nombre: 'Tarde de Clásicos', tipo: 'Musical' },
      { hora: '20:00 – 24:00', nombre: 'Fiesta en Misión', tipo: 'Especial' },
    ],
  },
  {
    dia: 'Domingo',
    color: '#1a237e',
    programas: [
      { hora: '08:00 – 11:00', nombre: 'Reflexión Comunitaria', tipo: 'Espiritual' },
      { hora: '11:00 – 14:00', nombre: 'Familia y Tradición', tipo: 'Familiar' },
      { hora: '15:00 – 18:00', nombre: 'El Zulia Suena', tipo: 'Musical' },
      { hora: '20:00 – 23:00', nombre: 'Cierre Dominical', tipo: 'Cultural' },
    ],
  },
];

const tipoBadge: Record<string, string> = {
  'Matutino':       'bg-yellow-100 text-yellow-800',
  'Informativo':    'bg-blue-100 text-blue-800',
  'Cultural':       'bg-purple-100 text-purple-800',
  'Entretenimiento':'bg-pink-100 text-pink-800',
  'Musical':        'bg-green-100 text-green-800',
  'Educativo':      'bg-teal-100 text-teal-800',
  'Económico':      'bg-orange-100 text-orange-800',
  'Comunitario':    'bg-indigo-100 text-indigo-800',
  'Deportivo':      'bg-red-100 text-red-800',
  'Especial':       'bg-brand-red/10 text-brand-red',
  'Espiritual':     'bg-amber-100 text-amber-800',
  'Familiar':       'bg-emerald-100 text-emerald-800',
};
---

<Layout
  title="Programación 2023 — Misión 94.3 FM"
  description="Conoce la programación semanal de Misión 94.3 FM, radio comunitaria de Cabimas, Zulia."
>

  <!-- Banner -->
  <section
    class="py-24 text-center text-white relative overflow-hidden"
    style="background: linear-gradient(135deg, #0a0e52, #1a237e);"
  >
    <div class="absolute inset-0 opacity-5"
         style="background-image: repeating-linear-gradient(0deg, #fff 0, #fff 1px, transparent 1px, transparent 40px), repeating-linear-gradient(90deg, #fff 0, #fff 1px, transparent 1px, transparent 40px);"></div>
    <div class="relative z-10 max-w-2xl mx-auto px-4">
      <span class="text-brand-red font-bold uppercase tracking-widest text-sm">Al aire</span>
      <h1 class="text-4xl sm:text-5xl font-black mt-3 mb-4">PROGRAMACIÓN 2023</h1>
      <p class="text-blue-200 text-lg">Desde Misión 94.3 FM con contenido para toda la familia</p>
    </div>
  </section>

  <!-- Aviso -->
  <section class="py-6 bg-brand-red/10 border-b border-brand-red/20">
    <p class="text-center text-sm text-brand-red font-semibold px-4">
      📻 Los horarios pueden variar · Sintonízanos en el 94.3 FM o escúchanos en línea
    </p>
  </section>

  <!-- Grid de programas -->
  <section class="py-16 bg-neutral-light">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {dias.map(d => (
          <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-sm">
            <!-- Day header -->
            <div class="px-5 py-4 text-white font-black text-lg" style={`background: ${d.color};`}>
              {d.dia}
            </div>
            <!-- Programs -->
            <div class="p-4 flex flex-col gap-3">
              {d.programas.map(p => (
                <div class="flex flex-col gap-1 border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                  <span class="text-xs text-gray-400 font-mono">{p.hora}</span>
                  <span class="font-semibold text-neutral-dark text-sm">{p.nombre}</span>
                  <span class:list={['text-xs font-semibold px-2 py-0.5 rounded-full self-start', tipoBadge[p.tipo] || 'bg-gray-100 text-gray-600']}>
                    {p.tipo}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-white text-center">
    <h2 class="text-2xl font-black text-brand-dark mb-4">¿Quieres saber más?</h2>
    <p class="text-gray-500 mb-6 max-w-md mx-auto">
      Para información actualizada contáctanos directamente o síguenos en redes sociales.
    </p>
    <a
      href="/contacto"
      class="inline-flex items-center gap-2 bg-brand-red text-white font-bold px-8 py-3 rounded-full hover:bg-red-700 transition-colors"
    >
      Contáctanos
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </section>

</Layout>
